{
  "name": "dn-second-brain-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node/Express API for Daniel Negreanu Second Brain coaching.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "eval:voice": "tsx scripts/run-real-evals.ts",
    "integration:day1-day2": "tsx scripts/run-day1-day2-integration.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^20.19.25",
    "node-mocks-http": "^1.17.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  }
}
