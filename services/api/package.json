{
  "name": "dn-second-brain-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Node/Express API for Daniel Negreanu Second Brain coaching.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "eval:voice": "tsx scripts/run-real-evals.ts",
    "integration:poker-coaching": "tsx scripts/run-poker-coaching-integration.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.68.0",
    "@clerk/express": "2.1.21",
    "@upstash/redis": "1.37.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "zod": "4.4.2"
  },
  "overrides": {
    "qs": "6.15.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "20.19.39",
    "node-mocks-http": "1.17.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "6.4.2",
    "vitest": "3.2.4"
  }
}
